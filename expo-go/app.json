{
  "expo": {
    "name": "ColdKeep Go",
    "slug": "coldkeep-go",
    "version": "0.1.0",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android"
    ],
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "ColdKeep uses the microphone to check bottle audio and collect labeled samples."
        }
      ],
      "expo-sharing",
      "expo-notifications"
    ],
    "android": {
      "permissions": [
        "RECORD_AUDIO"
      ]
    }
  }
}
